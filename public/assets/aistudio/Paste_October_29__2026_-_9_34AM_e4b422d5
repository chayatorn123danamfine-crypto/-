 {n:"Cefepime 1 g", th:"เซฟีพิม", c:"Cephalosporin gen 4", src:1, g:[
   {l:"", r:[[61,G,"CrCl ≥ 61","2 g ทุก 8 ชม."],[50.1,61,"CrCl 50–60","1 g ทุก 8 ชม."],[30,50.1,"CrCl 30–50","1 g ทุก 8 ชม."],[10,30,"CrCl 10–29","1 g ทุก 12 ชม."],[0,10,"CrCl < 10","1 g ทุก 24 ชม."]], hd:"1 g ทุก 24 ชม. (วันที่ HD ให้หลัง HD)"}]},
 
 {n:"Ceftaroline 600 mg", th:"เซฟตาโรลีน", c:"Cephalosporin (anti-MRSA)", src:1, g:[
   {l:"Mild – Moderate", r:[[50.1,G,"CrCl > 50","600 mg ทุก 12 ชม."],[31,50.1,"CrCl 31–50","400 mg ทุก 12 ชม."],[15,31,"CrCl 15–30","300 mg ทุก 12 ชม."],[10,15,"CrCl ≤ 14 (10–14)","200 mg ทุก 12 ชม."],[0,10,"CrCl < 10","200 mg ทุก 12 ชม."]], hd:"200 mg ทุก 12 ชม."},
   {l:"Severe", r:[[50.1,G,"CrCl > 50","600 mg ทุก 8 ชม."],[31,50.1,"CrCl 31–50","400 mg ทุก 8 ชม."],[15,31,"CrCl 15–30","300 mg ทุก 8 ชม."],[10,15,"CrCl ≤ 14 (10–14)","200 mg ทุก 8 ชม."],[0,10,"CrCl < 10","200 mg ทุก 8 ชม."]], hd:"200 mg ทุก 8 ชม."}]},
 
 {n:"Piperacillin 4 g/Tazobactam 500 mg", th:"ไพเพอราซิลลิน/ทาโซแบคแทม", c:"Antipseudomonal penicillin + β-lactamase inhibitor", src:1, g:[
