function animateNum(el, to, dec){
  if (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches){ el.textContent = to.toFixed(dec); return; }
  const t0 = performance.now(), dur = 700;
  (function f(t){
    const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
    el.textContent = (to * e).toFixed(dec);
    if (k < 1) requestAnimationFrame(f); else el.textContent = to.toFixed(dec);
  })(t0);
}
 
