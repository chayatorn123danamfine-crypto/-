/* --- หารูปแบบเม็ดยาที่กินง่ายที่สุดให้ได้ TWD ตามเป้าหมาย ---
   หลักการ: แบ่งขนาดยาแต่ละวันให้ใกล้เคียงกันที่สุด (ต่างกันไม่เกิน 1 mg/วัน)
   → เลือกชุดเม็ดที่ใช้ "จำนวนเม็ดรวม/สัปดาห์น้อยที่สุด" → "จำนวนสีน้อยที่สุด"
   → ถ้าเท่ากัน เลือกสีที่ผู้ป่วยมีอยู่เดิม → ใช้เม็ดใหญ่ก่อน
   (หน่วยภายในเป็น 0.5 mg; ใช้เม็ดครึ่งเฉพาะเมื่อ TWD ลงท้าย .5)                           */
function tabCombos(v, half){                    // v = หน่วย 0.5 mg
  const out = [], H = half ? 1 : 0;
  for (let nP = 0; nP * 10 <= v; nP++) for (let hP = 0; hP <= H; hP++){
    const r1 = v - nP * 10 - hP * 5; if (r1 < 0) continue;
    for (let nB = 0; nB * 6 <= r1; nB++) for (let hB = 0; hB <= H; hB++){
      const r2 = r1 - nB * 6 - hB * 3; if (r2 < 0) continue;
      let nW, hW = 0;
      if (r2 % 2 === 0) nW = r2 / 2;
      else { if (!half) continue; nW = (r2 - 1) / 2; hW = 1; }
      out.push({p: nP + hP / 2, b: nB + hB / 2, w: nW + hW / 2});
    }
  }
  return out;
}
const pieces = c => WT.reduce((s, t) => s + Math.ceil(c[t.k]), 0);
const splits = c => WT.reduce((s, t) => s + (c[t.k] % 1 ? 1 : 0), 0);
const kinds  = c => WT.filter(t => c[t.k] > 0).length;
 
function planRegimen(T, curColors){
  const isHalf = Math.abs(T - Math.round(T)) > 1e-9;
  const step = isHalf ? 1 : 2, D = Math.round(T * 2) / step;
  const q = Math.floor(D / 7), r = D % 7;
  const lowU = q * step, highU = (q + 1) * step;
  const lows = tabCombos(lowU, isHalf), highs = r > 0 ? tabCombos(highU, isHalf) : [null];
  let best = null, bestKey = null;
  for (const lo of lows) for (const hi of highs){
    const nl = 7 - r, nh = r;
    const wk = {};
    WT.forEach(t => wk[t.k] = lo[t.k] * nl + (hi ? hi[t.k] * nh : 0));
    const used = WT.filter(t => wk[t.k] > 0);
    const key = [
      nl * splits(lo) + (hi ? nh * splits(hi) : 0),
      nl * pieces(lo) + (hi ? nh * pieces(hi) : 0),
      used.length,
      curColors ? used.filter(t => !curColors.has(t.k)).length : 0,
      wk.w, wk.b
    ];
    let better = !best;
    if (best) for (let i = 0; i < key.length; i++){ if (key[i] !== bestKey[i]){ better = key[i] < bestKey[i]; break; } }
    if (better){ best = {lo, hi}; bestKey = key; }
  }
  // วันที่ได้ขนาดสูงกว่า: กระจายห่างกันตลอดสัปดาห์ (เริ่มวันจันทร์)
  const highDays = new Set();
  for (let i = 0; i < r; i++) highDays.add(Math.floor(i * 7 / r));
  const sched = [];
  for (let d = 0; d < 7; d++) sched.push(highDays.has(d) ? best.hi : best.lo);
  return {sched, isHalf};
}
 
const comboKey = c => WT.map(t => c[t.k]).join("/");
function comboTxt(c){
  const parts = WT.filter(t => c[t.k] > 0).map(t => `${t.name} ${tabTxt(c[t.k])}`);
  return parts.length ? parts.join(" + ") : "งดยา";
}
function chips(c){
  const parts = WT.filter(t => c[t.k] > 0).map(t => `<i class="tdot ${t.k}"></i>${fracTxt(c[t.k])}`);
  return parts.length ? parts.join(" ") : "—";
}
 
function renderWF(){
  const o = parseFloat(document.getElementById("wfo").value);
  const n = parseFloat(document.getElementById("wfn").value);
  const out = document.getElementById("wfOut"), plan = document.getElementById("wfPlan");
 
  /* ร้อยละการปรับยา */
  if (!(o > 0) || isNaN(n) || n < 0){
    out.innerHTML = '<div class="gwarn">กรอก Dose เดิม และ Dose ปรับใหม่ (mg/สัปดาห์) เพื่อคำนวณร้อยละการปรับยา</div>';
  } else {
    const p = (n - o) / o * 100;                 // (ใหม่ − เดิม) ÷ เดิม × 100
    const sign = p > 0 ? "+" : "";
    const dir = p > 0 ? "เพิ่มขึ้น ▲" : (p < 0 ? "ลดลง ▼" : "ไม่เปลี่ยนแปลง");
    const warn = Math.abs(p) > 20
      ? '<div class="gwarn">เปอร์เซ็นต์การปรับยาเกินประมาณร้อยละ 20 ต่อครั้ง — พิจารณาทบทวนขนาดยา</div>'
      : (p !== 0 ? '<div class="gnote" style="color:var(--pink-d)">อยู่ในช่วงประมาณร้อยละ 20 ต่อครั้งที่แนะนำ</div>' : "");
    out.innerHTML = `<div class="gblock" style="text-align:center">
        <div class="unit">เปอร์เซ็นต์การปรับยา</div>
        <div class="wbig">${sign}${p.toFixed(2)}%</div>
        <div class="unit">${dir} · ${mgFmt(o)} → ${mgFmt(n)} mg/สัปดาห์ (เปลี่ยน ${sign}${mgFmt(n - o)} mg/สัปดาห์)</div>
        ${warn}</div>`;
  }
 
  /* รูปแบบการรับประทานที่แนะนำ */
  if (isNaN(n) || n <= 0){ plan.innerHTML = ""; return; }
  if (Math.abs(n * 2 - Math.round(n * 2)) > 1e-9){
    plan.innerHTML = '<div class="gwarn">Dose ปรับใหม่ต้องเป็นจำนวนที่ลงตัวกับครึ่งเม็ด (เช่น 28 หรือ 22.5 mg/สัปดาห์) จึงจะจัดรูปแบบเม็ดยาได้</div>';
    return;
  }
  if (n > 140){ plan.innerHTML = '<div class="gwarn">Dose ปรับใหม่สูงกว่า 140 mg/สัปดาห์ — กรุณาตรวจสอบตัวเลขอีกครั้ง</div>'; return; }
 
  const tw = curWeek(), hasCur = tw > 0;
  const curColors = hasCur ? new Set(WT.filter(t => wf[t.k].d.some(Boolean)).map(t => t.k)) : null;
  const {sched, isHalf} = planRegimen(n, curColors);
  const total = sched.reduce((s, c) => s + comboMg(c), 0);
 
  // สรุปเป็นข้อความ: จัดกลุ่มวันที่ใช้ชุดเม็ดเหมือนกัน
  const groups = new Map();
  sched.forEach((c, i) => { const k = comboKey(c); if (!groups.has(k)) groups.set(k, {c, days:[]}); groups.get(k).days.push(i); });
  const arr = [...groups.values()].sort((a, b) => b.days.length - a.days.length);
  let lines;
  if (arr.length === 1) lines = [`<b>${comboTxt(arr[0].c)}</b> (รวม ${mgFmt(comboMg(arr[0].c))} mg) <b>ทุกวัน</b>`];
  else lines = arr.slice().reverse().map((g, idx, a) => {
    const when = idx === a.length - 1 ? "วันที่เหลือ" : "วัน" + g.days.map(i => DAYS[i]).join(", วัน");
    return `${when}: <b>${comboTxt(g.c)}</b> (รวม ${mgFmt(comboMg(g.c))} mg)`;
  });
 
  // สิ่งที่เปลี่ยนจากเดิม (กรณีทุกวันเปลี่ยนเท่ากัน)
  let chg = "";
  if (hasCur){
    const parts = [];
    WT.forEach(t => {
      const d = sched.map((c, i) => c[t.k] - curDay(i)[t.k]);
      if (d.every(x => x === d[0]) && d[0] !== 0) parts.push(`${d[0] > 0 ? "เพิ่ม" : "ลด"}เม็ด${t.name} ${tabTxt(Math.abs(d[0]))}ทุกวัน`);
    });
    chg = parts.length
      ? `<div class="chgtxt"><b>สิ่งที่เปลี่ยนจากเดิม:</b> ${parts.join(" และ ")}</div>`
      : (n === tw ? '<div class="chgtxt">ขนาดยารวมเท่าเดิม</div>' : '<div class="chgtxt"><b>สิ่งที่เปลี่ยนจากเดิม:</b> ดูตารางเปรียบเทียบรายวันด้านล่าง</div>');
  }
 
  const rows = sched.map((c, i) => {
    const cur = curDay(i), changed = hasCur && comboKey(cur) !== comboKey(c);
    return `<tr class="${changed ? "chg" : ""}"><td class="l">${DAYS[i]}</td>${hasCur ? `<td>${chips(cur)}</td>` : ""}<td>${chips(c)}</td><td>${mgFmt(comboMg(c))}</td></tr>`;
  }).join("");
 
  plan.innerHTML = `<div class="plan">
    <h3>รูปแบบการรับประทานที่แนะนำ — ${mgFmt(n)} mg/สัปดาห์</h3>
    ${lines.map(l => `<div class="line">${l}</div>`).join("")}
    ${isHalf ? '<div class="gnote">ขนาดยารวมนี้ต้องใช้เม็ดครึ่ง (หักครึ่งเม็ดตามเส้นแบ่งของเม็ดยา)</div>' : ""}
    ${chg}
    <table class="tbl wtbl">
      <tr><th>วัน</th>${hasCur ? "<th>เดิม</th>" : ""}<th>ใหม่</th><th>mg</th></tr>
      ${rows}
      <tfoot><tr><td class="l">รวม/สัปดาห์</td>${hasCur ? `<td>${mgFmt(tw)} mg</td>` : ""}<td>${mgFmt(total)} mg</td><td></td></tr></tfoot>
    </table>
    <div class="ok">${Math.abs(total - n) < 1e-9 ? "✓ ผลรวมต่อสัปดาห์ตรงตามเป้าหมาย " + mgFmt(n) + " mg" : "ผลรวมไม่ตรงกับเป้าหมาย — กรุณาตรวจสอบ"}</div>
    <div class="gnote" style="color:var(--muted)">แนะนำให้รับประทานเวลาเดียวกันทุกวัน · รูปแบบนี้เป็นเพียงการจัดเม็ดยาให้ได้ขนาดรวมตามที่เภสัชกร/แพทย์กำหนด โดยพิจารณาจากระดับ INR และข้อมูลทางคลินิกของผู้ป่วย</div>
  </div>`;
}
 
/* ---------- TB ---------- */
function renderTB(){
  const w = parseFloat(document.getElementById("tbw").value);
  const out = document.getElementById("tbOut");
  const ok = w > 0;
  let h = "";
  if (ok && (w < 35 || w > 70)) h += '<div class="gwarn">น้ำหนัก &lt; 35 หรือ &gt; 70 กก. — ให้คำนวณตามน้ำหนักตัว (ดูส่วน “คำนวณตามน้ำหนักตัว” ด้านล่าง)</div>';
  else h += '<div class="gnote">กรณีน้ำหนัก &lt; 35 หรือ &gt; 70 กก. ให้คำนวณตามน้ำหนักตัว</div>';
 
  const bi = !ok ? -1 : (w >= 70 ? 2 : (w >= 50 ? 1 : (w >= 35 ? 0 : -1)));
  const T = [["35–49",300,450,1000,800],["50–69",300,600,1500,1000],["&gt; 70",300,600,2000,1200]];
  h += `<div class="gblock"><h3>ขนาดยา TB ก่อนเริ่มรักษา (mg/วัน)</h3>
    <table class="tbl"><tr><th>น้ำหนัก (กก.)</th><th>I</th><th>R</th><th>Z</th><th>E</th></tr>
    ${T.map((r,i) => `<tr class="${i===bi?'hit':''}"><td>${r[0]}</td><td>${r[1]}</td><td>${r[2]}</td><td>${r[3]}</td><td>${r[4]}</td></tr>`).join("")}
    </table></div>`;
 
  const P = [
    ["Isoniazid", "4–6 mg/kg/day", 4, 6],
    ["Rifampicin", "8–12 mg/kg/day", 8, 12],
    ["Pyrazinamide", "20–30 mg/kg/day", 20, 30],
    ["Ethambutol", "15–20 mg/kg/day", 15, 20]
  ];
  h += `<div class="gblock"><h3>คำนวณตามน้ำหนักตัว</h3>` + P.map(p =>
    `<div class="gsub">${p[0]} ${p[1]}</div><div class="grow"><div class="gl"><span class="gf">ขนาดยา</span></div><div class="gr">${ok ? fmt(w*p[2]) + " ถึง " + fmt(w*p[3]) + ' <span class="gu">mg/day</span>' : "—"}</div></div>`
  ).join("") + `</div>`;
 
  const si = !ok ? -1 : (w < 35 ? 0 : (w <= 70 ? 1 : 2));
  const S = [["&lt; 35 กก.","100 mg/day"],["&gt; 35–70 กก.","150 mg/day"],["&gt; 70 กก.","200 mg/day"]];
  h += `<div class="gblock"><h3>Isoniazid ปรับตามน้ำหนักตัวและชนิด Acetylator gene (NAT2 genotype)</h3>
    <div class="gnote" style="color:var(--ink)">Rapid และ Intermediate acetylator ใช้ขนาดยาปกติ · Slow acetylator ปรับขนาดยาดังนี้</div>
    ${S.map((r,i) => `<div class="grow ${i===si?'hit':''}"><div class="gl">${r[0]}</div><div class="gr">${r[1]}</div></div>`).join("")}
    <div class="gwarn">Isoniazid / Rifampicin / Pyrazinamide: ถ้าค่า ALT มากกว่า 150 รายงานแพทย์และปรับขนาดยา</div></div>`;
  out.innerHTML = h;
}
 
