function renderDrug(){
  const q = document.getElementById("drugIn").value.trim().toLowerCase();
  const out = document.getElementById("drugOut");
  if (!q){ out.innerHTML = ""; return; }
  const hits = DRUGS.filter(d => d.n.toLowerCase().includes(q) || d.th.toLowerCase().includes(q));
  if (!hits.length){
    out.innerHTML = '<div class="drug">ไม่พบยาในฐานข้อมูล — ลองพิมพ์ชื่อสามัญทางยา (generic name)</div>';
    return;
  }
  const cv = Math.round(crcl * 10) / 10;   // เทียบด้วยค่าที่แสดงบนหน้าจอ (ทศนิยม 1 ตำแหน่ง)
  out.innerHTML = hits.map(d => {
    const groups = d.g || [{l:"", r:d.r}];
    const body = groups.map(gr => {
      const bands = gr.r.map(x => {
        const lo = x[0], hi = x[1], txt = x[x.length-1];
        const label = x.length === 4 ? x[2] : (hi >= G ? `CrCl ≥ ${lo}` : (lo === 0 ? `CrCl < ${hi}` : `CrCl ${lo} ถึงน้อยกว่า ${hi}`));
        const m = cv >= lo && cv < hi;
        return `<div class="band ${m?'match':''}"><b>${m?'✓ ตรงกับผู้ป่วย — ':''}${label} mL/min</b>${txt}</div>`;
      }).join("");
      const hd = gr.hd ? `<div class="band hd"><b>ผู้ป่วยฟอกไต (Intermittent HD)</b>${gr.hd}</div>` : "";
      return (gr.l ? `<div class="grp">${gr.l}</div>` : "") + bands + hd;
    }).join("");
    return `<div class="drug"><h3>${d.n}${d.src?'<span class="src">ตาราง ม.ธรรมศาสตร์ 2022</span>':''}</h3><div class="cls">${d.th} · ${d.c}</div>${body}${d.note?`<div class="note"><b>หมายเหตุ:</b> ${d.note}</div>`:""}</div>`;
  }).join("");
}
 
