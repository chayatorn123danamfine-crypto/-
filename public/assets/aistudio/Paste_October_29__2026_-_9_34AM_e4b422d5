<script>
const PASSWORD = "12367";
let sex = null, crcl = null;
 
const NAME_RENAL = "ระบบปรับขนาดยาตามค่าการทำงานของไต", NAME_WEIGHT = "ระบบปรับขนาดยาตามน้ำหนัก";
const BAR = {pm:"ระบบปรับขนาดยา", p2:NAME_RENAL, p3:NAME_RENAL, p4:NAME_RENAL, g0:NAME_WEIGHT, gk:NAME_WEIGHT, gb:NAME_WEIGHT, gv:NAME_WEIGHT, gw:NAME_WEIGHT, gt:NAME_WEIGHT};
const PAGES = ["p1","pm","p2","p3","p4","g0","gk","gb","gv","gw","gt"];
function show(id){
  PAGES.forEach(p => document.getElementById(p).classList.toggle("hidden", p !== id));
  document.body.classList.toggle("green", id.charAt(0) === "g");   // หน้าของระบบปรับขนาดยาตามน้ำหนักใช้ธีมเขียว
  document.getElementById("bar").classList.toggle("hidden", id === "p1");
  if (BAR[id]) document.getElementById("barTitle").textContent = BAR[id];
  window.scrollTo(0,0);
  if (id === "p4") { document.getElementById("crclPill").textContent = "CrCl = " + crcl.toFixed(1) + " mL/min"; renderDrug(); }
}
 
function checkPw(){
  const v = document.getElementById("pw").value.trim();
  if (v === PASSWORD){ try{sessionStorage.setItem("ok","1")}catch(e){} show("pm"); }
  else document.getElementById("pwErr").textContent = "รหัสผ่านไม่ถูกต้อง กรุณาลองอีกครั้ง";
}
document.getElementById("pw").addEventListener("keydown", e => { if(e.key==="Enter") checkPw(); });
try{ if(sessionStorage.getItem("ok")==="1") show("pm"); }catch(e){}
 
function setSex(s){
  sex = s;
  document.getElementById("gM").classList.toggle("on", s==="M");
  document.getElementById("gF").classList.toggle("on", s==="F");
}
 
function calcCrCl(){
  const age = parseFloat(document.getElementById("age").value);
  const wt  = parseFloat(document.getElementById("wt").value);
  const scr = parseFloat(document.getElementById("scr").value);
  const err = document.getElementById("ptErr");
  if (!sex) return err.textContent = "กรุณาเลือกเพศ";
  if (!(age>0) || !(wt>0) || !(scr>0)) return err.textContent = "กรุณากรอกอายุ น้ำหนัก และ Serum creatinine ให้ครบ";
  if (age >= 140) return err.textContent = "อายุไม่ถูกต้อง";
  err.textContent = "";
 
  // CrCl = (140 - อายุ) × น้ำหนัก / (72 × SCr)  ; หญิง × 0.85
  let v = ((140 - age) * wt) / (72 * scr);
  if (sex === "F") v *= 0.85;
  crcl = v;
 
  animateNum(document.getElementById("crclVal"), v, 1);
  let st, col;
  if (v >= 90){ st="ปกติ (≥ 90)"; col="#1f9d6b"; }
  else if (v >= 60){ st="ลดลงเล็กน้อย (60–89)"; col="#6aa84f"; }
  else if (v >= 30){ st="ลดลงปานกลาง (30–59)"; col="#d98a00"; }
  else if (v >= 15){ st="ลดลงรุนแรง (15–29)"; col="#e0622b"; }
  else { st="ไตวายระยะสุดท้าย (< 15)"; col="#d6354b"; }
  const s = document.getElementById("stage"); s.textContent = st; s.style.background = col; s.classList.remove("pop"); void s.offsetWidth; s.classList.add("pop");
  document.getElementById("formula").innerHTML =
    "สูตร: (140 − " + age + ") × " + wt + " ÷ (72 × " + scr + ")" + (sex==="F" ? " × 0.85 (เพศหญิง)" : "") +
    "<br>หมายเหตุ: ใช้น้ำหนักจริงตามที่กรอก หากผู้ป่วยอ้วนหรือผอมมาก ควรพิจารณาใช้ IBW/AdjBW";
  show("p3");
}
 
/* ===== ฐานข้อมูลยา (ผู้ใหญ่) =====
   rule = [min, max, ข้อความ]  หรือ  [min, max, ป้ายช่วง CrCl, ข้อความ]   (min ≤ CrCl < max)
   g = กลุ่มย่อย (เช่น ความรุนแรง)  { l: ชื่อกลุ่ม, r: rules, hd: ขนาดยาเมื่อฟอกไต (Intermittent HD) }
   src:1 = มาจากตาราง ม.ธรรมศาสตร์ 2022
   หมายเหตุ: ค่า ">50" ใช้ขอบล่าง 50.1 เพราะเทียบกับ CrCl ที่ปัดทศนิยม 1 ตำแหน่ง */
const G = 1e9;
const NOTE_CARBA = "ครั้งแรกพิจารณาให้หยดใน 30 นาที ครั้งถัดไปจึงค่อยปรับเป็นหยดนานขึ้น เช่น meropenem, imipenem, doripenem อาจหยดนาน 3 ชม.";
const NOTE_SULB = "หากต้องการใช้ sulbactam ขนาดสูงเพื่อรักษาเชื้อดื้อยาหลายขนาน กรุณาปรึกษาหน่วยโรคติดเชื้อ";
const NC = "ไม่ต้องปรับขนาดยา";
// ยาที่แบ่งช่วงตามหัวตาราง: CrCl > 50 / 10–50 / < 10 + ผู้ป่วยฟอกไต (IHD)
function std(n, th, c, a, b, d, hd, note){
  return {n, th, c, g:[{l:"", r:[[50.1,G,"CrCl > 50",a],[10,50.1,"CrCl 10–50",b],[0,10,"CrCl < 10",d]], hd}], note};
}
 
const DRUGS = [
 /* ---------- จากตาราง ม.ธรรมศาสตร์ 2022 ---------- */
 {n:"Ceftazidime 1 g", th:"เซฟตาซิดีม", c:"Cephalosporin gen 3 (antipseudomonal)", src:1, g:[
   {l:"Mild – Moderate", r:[[50.1,G,"CrCl > 50","1 g ทุก 8 ชม."],[30,50.1,"CrCl 30–50","1 g ทุก 12 ชม."],[10,30,"CrCl 10–29","1 g ทุก 24 ชม."],[0,10,"CrCl < 10","500 mg ทุก 24 ชม."]], hd:"500 mg ทุก 24 ชม. (วันที่ HD ให้หลัง HD)"},
